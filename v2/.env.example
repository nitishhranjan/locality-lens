# Provider: "groq" (default, what this runs on today) or "openai"
LLM_PROVIDER=groq

# Retried automatically if the provider above fails at request time.
FALLBACK_PROVIDER=groq

# Required for LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-key-here

# Required for LLM_PROVIDER=openai (also used as fallback target if set)
OPENAI_API_KEY=sk-your-key-here

# Optional model overrides (Groq retires models periodically)
# INTENT_MODEL=
# SUMMARY_MODEL=
# SEARCH_RADIUS_M=2000
